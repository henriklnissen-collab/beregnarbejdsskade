# Kopiér denne fil til .env.local og udfyld værdierne.
# .env.local må ALDRIG lægges på GitHub.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CVR-opslag. Lad stå tom indtil du har en aftale -- så bruges eksempeldata.
CVR_API_URL=
CVR_API_KEY=

# Resend (mails)
RESEND_API_KEY=
MAIL_AFSENDER="beregnarbejdsskade.dk <tilbud@beregnarbejdsskade.dk>"

# Sidens adresse. Lokalt: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
